{
  "name": "mcp-grand-prix",
  "version": "0.1.0",
  "description": "Browser-based multiplayer Grand Prix tactics game where LLM agents race via MCP. Game server + MCP tools, Three.js spectator, reactive strategy windows, and a live demo.",
  "type": "module",
  "main": "src/server/main.js",
  "scripts": {
    "start": "node src/server/main.js",
    "race": "node scripts/runRace.js",
    "demo": "node scripts/demo.js",
    "demo:public": "node scripts/demo.js --url https://gp.peterfrank.se/mcp --watch https://gp.peterfrank.se/",
    "agent": "node agents/run.js",
    "test": "vitest run",
    "validate:tracks": "node scripts/validate-tracks.mjs",
    "visual": "node scripts/visualCheck.mjs",
    "visual:shots": "node scripts/sceneryShots.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vitest": "^4.1.9"
  }
}
